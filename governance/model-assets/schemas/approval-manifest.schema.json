{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearcore.example/schemas/approval-manifest.schema.json",
  "title": "Model Asset Approval Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "asset_id", "candidate_sha256", "candidate_record_sha256", "legal_approval_id", "legal_review_record_sha256", "approver_identity", "approval_date", "redistribution_terms", "conversion_terms", "approved_for_release", "key_id", "signature"],
  "properties": {
    "status": {"const": "APPROVED"},
    "asset_id": {"const": "df-compatible-release-asset-v1"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legal_approval_id": {"type": "string", "minLength": 1},
    "legal_review_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approver_identity": {"type": "string", "minLength": 1},
    "approval_date": {"type": "string", "format": "date"},
    "redistribution_terms": {"type": "string", "minLength": 1},
    "conversion_terms": {"type": "string", "minLength": 1},
    "approved_for_release": {"const": true},
    "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
  }
}
